{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
    },
    "milestone": {
      "const": "M1"
    },
    "status": {
      "enum": ["PLANNED_NOT_EXECUTED", "COMPLETED"]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approved_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "protected_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "max_total_seconds",
        "scope_note"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "max_total_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "scope_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "level",
          "command",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "enum": [
              "static",
              "unit",
              "integration",
              "gpu",
              "evaluation"
            ]
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": {
            "const": true
          },
          "minimum_tests": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": ["TO_IMPLEMENT", "PASS"]
          }
        }
      }
    },
    "independent_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "status",
        "read_only",
        "review_actual_diff"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "status": {
          "enum": ["NOT_VERIFIED", "WAIVED_BY_OWNER"]
        },
        "read_only": {
          "const": true
        },
        "review_actual_diff": {
          "const": true
        }
      }
    },
    "base_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "base_commit_note": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "milestone",
    "status",
    "goal",
    "acceptance",
    "approved_paths",
    "protected_paths",
    "dependencies",
    "required_requirement_ids",
    "boundaries",
    "budgets",
    "gates",
    "independent_review",
    "base_commit",
    "base_commit_note"
  ]
}
