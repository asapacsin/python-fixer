{"behavior":"Return True if the directed graph with nodes 0..n-1 and [u, v] edges has a cycle.","bug_category":"comparison","buggy_code":"def has_cycle(n, edges):\n    indeg = [0] * n\n    out = [[] for unused in range(n)]\n    for u, v in edges:\n        out[u].append(v)\n        indeg[v] += 1\n    ready = [i for i in range(n) if indeg[i] == 0]\n    seen = 0\n    while ready:\n        u = ready.pop()\n        seen += 1\n        for v in out[u]:\n            indeg[v] -= 1\n            if indeg[v] == 0:\n                ready.append(v)\n    return seen <= n\n","difficulty":"hard","problem_id":"fixture-has_cycle-v3-2bec0df63097","provenance":{"license":"CC0-1.0","mutation_operator":"authored-bug-v1","mutation_seed":17,"path":"src/python_fixer/data/fixtures_v3.json","revision":"fixtures-v3","source_sha256":"e9740c69caa575ed0ef379638796b67c1d5c8f27968d7af70dcfc6736380d1dc","source_uri":"authored://python-fixer/fixtures-v3"},"reference_code":"def has_cycle(n, edges):\n    indeg = [0] * n\n    out = [[] for unused in range(n)]\n    for u, v in edges:\n        out[u].append(v)\n        indeg[v] += 1\n    ready = [i for i in range(n) if indeg[i] == 0]\n    seen = 0\n    while ready:\n        u = ready.pop()\n        seen += 1\n        for v in out[u]:\n            indeg[v] -= 1\n            if indeg[v] == 0:\n                ready.append(v)\n    return seen < n\n","schema_version":1,"signature":"has_cycle(n, edges)","source_family_id":"family-c96aa68913cc31b4","source_function_id":"fixture-has_cycle-v3","split":"validation","test_suite_id":"fixture-has_cycle-v3-tests-v1","test_suite_sha256":"28841e480066617aea47022f894eba1cc6639856f8be94ed2e3a07f81cc7384a","tests":[{"args":[2,[[0,1],[1,0]]],"comparator":"exact","expected":true,"kwargs":{},"test_id":"1"},{"args":[3,[[0,1],[1,2]]],"comparator":"exact","expected":false,"kwargs":{},"test_id":"2"},{"args":[1,[[0,0]]],"comparator":"exact","expected":true,"kwargs":{},"test_id":"3"},{"args":[2,[]],"comparator":"exact","expected":fa