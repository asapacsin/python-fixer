{"behavior":"Given undirected edges as [u, v] pairs of strings, return the fewest edges from start to goal, or -1.","bug_category":"algorithm","buggy_code":"def shortest_hops(edges, start, goal):\n    graph = {}\n    for u, v in edges:\n        graph.setdefault(u, []).append(v)\n    frontier, seen, dist = [start], {start}, 0\n    while frontier:\n        if goal in frontier:\n            return dist\n        nxt = []\n        for node in frontier:\n            for n in graph.get(node, []):\n                if n not in seen:\n                    seen.add(n)\n                    nxt.append(n)\n        frontier, dist = nxt, dist + 1\n    return -1\n","difficulty":"hard","problem_id":"fixture-shortest_hops-v3-2bec0df63097","provenance":{"license":"CC0-1.0","mutation_operator":"authored-bug-v1","mutation_seed":17,"path":"src/python_fixer/data/fixtures_v3.json","revision":"fixtures-v3","source_sha256":"1943ad1c87c486ee9e7e8a71b8c4e560b5cbecd2279c5ffef00841ed5f31578d","source_uri":"authored://python-fixer/fixtures-v3"},"reference_code":"def shortest_hops(edges, start, goal):\n    graph = {}\n    for u, v in edges:\n        graph.setdefault(u, []).append(v)\n        graph.setdefault(v, []).append(u)\n    frontier, seen, dist = [start], {start}, 0\n    while frontier:\n        if goal in frontier:\n            return dist\n        nxt = []\n        for node in frontier:\n            for n in graph.get(node, []):\n                if n not in seen:\n                    seen.add(n)\n                    nxt.append(n)\n        frontier, dist = nxt, dist + 1\n    return -1\n","schema_version":1,"signature":"shortest_hops(edges, start, goal)","source_family_id":"family-fab45dceb0c85a24","source_function_id":"fixture-shortest_hops-v3","split":"validation","test_suite_id":"fixture-shortest_hops-v3-tests-v1","test_suite_sha256":"bd2174b8333e0b8de87d158af479688d211d800fa2e6b6608b9b8ce8a80c3819","tests":[{"args":[[["a","b"],["b","c"]],"a","c"],"comparator":"exact","expected":2,"kwargs":