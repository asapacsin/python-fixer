{"behavior":"Process ops: ['push', x] enqueues x, ['pop'] dequeues; return the list of popped values in order.","bug_category":"branch","buggy_code":"def simulate_queue(ops):\n    inbox, outbox, popped = [], [], []\n    for op in ops:\n        if op[0] == 'push':\n            inbox.append(op[1])\n        else:\n            while inbox:\n                outbox.append(inbox.pop())\n            popped.append(outbox.pop())\n    return popped\n","difficulty":"hard","problem_id":"fixture-simulate_queue-v3-2bec0df63097","provenance":{"license":"CC0-1.0","mutation_operator":"authored-bug-v1","mutation_seed":17,"path":"src/python_fixer/data/fixtures_v3.json","revision":"fixtures-v3","source_sha256":"6136115119319772f0d194e48b46648980e24a172628bcb135b38d58ab67993d","source_uri":"authored://python-fixer/fixtures-v3"},"reference_code":"def simulate_queue(ops):\n    inbox, outbox, popped = [], [], []\n    for op in ops:\n        if op[0] == 'push':\n            inbox.append(op[1])\n        else:\n            if not outbox:\n                while inbox:\n                    outbox.append(inbox.pop())\n            popped.append(outbox.pop())\n    return popped\n","schema_version":1,"signature":"simulate_queue(ops)","source_family_id":"family-da0fa6d157425f30","source_function_id":"fixture-simulate_queue-v3","split":"validation","test_suite_id":"fixture-simulate_queue-v3-tests-v1","test_suite_sha256":"ab73efda3bf6ff8c1b3643b6d45cae3f5d56c46f56197b94a76f0cb073ee319d","tests":[{"args":[[]],"comparator":"exact","expected":[],"kwargs":{},"test_id":"1"},{"args":[[["push",1],["push",2],["pop"],["pop"]]],"comparator":"exact","expected":[1,2],"kwargs":{},"test_id":"2"},{"args":[[["push",1],["pop"],["push",2],["pop"]]],"comparator":"exact","expected":[1,2],"kwargs":{},"test_id":"3"},{"args":[[["push",1],["push",2],["pop"],["push",3],["pop"],["pop"]]],"comparator":"exact","expected":[1,2,3],"kwargs":{},"test_id":"4"}],"verification":{"baseline_failed_ids":["4"],"baseline_passed_ids":["1","2"