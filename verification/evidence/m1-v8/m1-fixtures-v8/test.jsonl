{"behavior":"Tax 0% up to 10000, 10% on the part up to 40000, 20% above; return the integer total (floor).","bug_category":"operator","buggy_code":"def progressive_tax(income):\n    tax = 0\n    if income > 10000:\n        tax += (min(income, 40000) - 10000) * 10 // 100\n    if income > 40000:\n        tax += income * 20 // 100\n    return tax\n","difficulty":"medium","problem_id":"fixture-progressive_tax-v3-2bec0df63097","provenance":{"license":"CC0-1.0","mutation_operator":"authored-bug-v1","mutation_seed":17,"path":"src/python_fixer/data/fixtures_v3.json","revision":"fixtures-v3","source_sha256":"647a376c59d5a40e48fbc6473c6212030dcda1b6d9f2203a9a26f99b96bc80de","source_uri":"authored://python-fixer/fixtures-v3"},"reference_code":"def progressive_tax(income):\n    tax = 0\n    if income > 10000:\n        tax += (min(income, 40000) - 10000) * 10 // 100\n    if income > 40000:\n        tax += (income - 40000) * 20 // 100\n    return tax\n","schema_version":1,"signature":"progressive_tax(income)","source_family_id":"family-f3ffbef7390a55b2","source_function_id":"fixture-progressive_tax-v3","split":"test","test_suite_id":"fixture-progressive_tax-v3-tests-v1","test_suite_sha256":"fa213c145762a799ee4e798942c6d89dddcca9dd03f638ff02c41134a2c59e0e","tests":[{"args":[5000],"comparator":"exact","expected":0,"kwargs":{},"test_id":"1"},{"args":[20000],"comparator":"exact","expected":1000,"kwargs":{},"test_id":"2"},{"args":[40000],"comparator":"exact","expected":3000,"kwargs":{},"test_id":"3"},{"args":[50000],"comparator":"exact","expected":5000,"kwargs":{},"test_id":"4"},{"args":[10000],"comparator":"exact","expected":0,"kwargs":{},"test_id":"5"}],"verification":{"baseline_failed_ids":["4"],"baseline_passed_ids":["1","2","3","5"],"evidence_sha256":"b6b24f7a6f6ef8a23760a1fed4e8d54244bb858f3d4835dcb4e7532dbfe0ae95","image_digest":"python@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535","policy_sha256":"5bea6490a29968b31282f5e032d43f3cad7f7aab915f83f5ba26e