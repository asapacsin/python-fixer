{"behavior":"Return the representation of n >= 0 in base 2..16 using digits 0-9a-f.","bug_category":"algorithm","buggy_code":"def int_to_base(n, base):\n    digits = '0123456789abcdef'\n    if n == 0:\n        return '0'\n    out = ''\n    while n:\n        n, r = divmod(n, base)\n        out = out + digits[r]\n    return out\n","difficulty":"medium","problem_id":"fixture-int_to_base-v3-2bec0df63097","provenance":{"license":"CC0-1.0","mutation_operator":"authored-bug-v1","mutation_seed":17,"path":"src/python_fixer/data/fixtures_v3.json","revision":"fixtures-v3","source_sha256":"238957728ae7fa502fdb0715c7ce4af880ee1101dae0d86cd853416dde63d917","source_uri":"authored://python-fixer/fixtures-v3"},"reference_code":"def int_to_base(n, base):\n    digits = '0123456789abcdef'\n    if n == 0:\n        return '0'\n    out = ''\n    while n:\n        n, r = divmod(n, base)\n        out = digits[r] + out\n    return out\n","schema_version":1,"signature":"int_to_base(n, base)","source_family_id":"family-7ac12867a82449b3","source_function_id":"fixture-int_to_base-v3","split":"test","test_suite_id":"fixture-int_to_base-v3-tests-v1","test_suite_sha256":"a2b29defe8c055f3f83997096de4e2441e3085a578655c0f471c24c5afcb3a34","tests":[{"args":[0,2],"comparator":"exact","expected":"0","kwargs":{},"test_id":"1"},{"args":[10,2],"comparator":"exact","expected":"1010","kwargs":{},"test_id":"2"},{"args":[255,16],"comparator":"exact","expected":"ff","kwargs":{},"test_id":"3"},{"args":[7,8],"comparator":"exact","expected":"7","kwargs":{},"test_id":"4"},{"args":[100,10],"comparator":"exact","expected":"100","kwargs":{},"test_id":"5"}],"verification":{"baseline_failed_ids":["2","5"],"baseline_passed_ids":["1","3","4"],"evidence_sha256":"ddfc05d6e43058b777bde3232fb04e15d329005b277e2c3f86830c2477707ea7","image_digest":"python@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535","policy_sha256":"5bea6490a29968b31282f5e032d43f3cad7f7aab915f83f5ba26eae90dc0096d","status":"VERIFIED"}}
