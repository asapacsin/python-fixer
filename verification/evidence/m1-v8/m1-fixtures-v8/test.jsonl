{"behavior":"Given 3 strings of 'X', 'O' or '.', return 'X' or 'O' if that player has three in a row, else '.'.","bug_category":"boundary","buggy_code":"def ttt_winner(board):\n    lines = [list(row) for row in board] + [list(col) for col in zip(*board)]\n    lines += [[board[i][i] for i in range(3)]]\n    for line in lines:\n        if line[0] != '.' and line.count(line[0]) == 3:\n            return line[0]\n    return '.'\n","difficulty":"medium","problem_id":"fixture-ttt_winner-v3-2bec0df63097","provenance":{"license":"CC0-1.0","mutation_operator":"authored-bug-v1","mutation_seed":17,"path":"src/python_fixer/data/fixtures_v3.json","revision":"fixtures-v3","source_sha256":"5019051d09c6917cdd207156097ee9515e6f5a34997723dfb31f27a4749f83b0","source_uri":"authored://python-fixer/fixtures-v3"},"reference_code":"def ttt_winner(board):\n    lines = [list(row) for row in board] + [list(col) for col in zip(*board)]\n    lines += [[board[i][i] for i in range(3)], [board[i][2 - i] for i in range(3)]]\n    for line in lines:\n        if line[0] != '.' and line.count(line[0]) == 3:\n            return line[0]\n    return '.'\n","schema_version":1,"signature":"ttt_winner(board)","source_family_id":"family-d14f44849a56ce6e","source_function_id":"fixture-ttt_winner-v3","split":"test","test_suite_id":"fixture-ttt_winner-v3-tests-v1","test_suite_sha256":"69d9fc9b9d5893bf13e5368d52907be4fc1d5f2e5c05e4909f9516418df31bec","tests":[{"args":[["XXX","O.O","..."]],"comparator":"exact","expected":"X","kwargs":{},"test_id":"1"},{"args":[["XO.","XO.",".O."]],"comparator":"exact","expected":"O","kwargs":{},"test_id":"2"},{"args":[["X.O",".XO","..X"]],"comparator":"exact","expected":"X","kwargs":{},"test_id":"3"},{"args":[["..O",".O.","OX."]],"comparator":"exact","expected":"O","kwargs":{},"test_id":"4"},{"args":[["XOX","OXO","OXO"]],"comparator":"exact","expected":".","kwargs":{},"test_id":"5"},{"args":[["...","...","..."]],"comparator":"exact","expected":".","kwargs":{},"test_id":"6"}],"veri