{"behavior":"Return the best total value of a 0/1 knapsack within capacity.","bug_category":"algorithm","buggy_code":"def knapsack(weights, values, capacity):\n    best = [0] * (capacity + 1)\n    for w, v in zip(weights, values):\n        for c in range(w, capacity + 1):\n            best[c] = max(best[c], best[c - w] + v)\n    return best[capacity]\n","difficulty":"hard","problem_id":"fixture-knapsack-v3-2bec0df63097","provenance":{"license":"CC0-1.0","mutation_operator":"authored-bug-v1","mutation_seed":17,"path":"src/python_fixer/data/fixtures_v3.json","revision":"fixtures-v3","source_sha256":"f85d5f92565041f778e6fdcf92596e669c2abfe8741bc76961b4440ada59e32f","source_uri":"authored://python-fixer/fixtures-v3"},"reference_code":"def knapsack(weights, values, capacity):\n    best = [0] * (capacity + 1)\n    for w, v in zip(weights, values):\n        for c in range(capacity, w - 1, -1):\n            best[c] = max(best[c], best[c - w] + v)\n    return best[capacity]\n","schema_version":1,"signature":"knapsack(weights, values, capacity)","source_family_id":"family-3f1e08db6cdbc1dc","source_function_id":"fixture-knapsack-v3","split":"test","test_suite_id":"fixture-knapsack-v3-tests-v1","test_suite_sha256":"df6581e9eebc25ff249d1e642186c29b3c9181e2d00aef56a919c86d14354960","tests":[{"args":[[1,3,4],[15,20,30],4],"comparator":"exact","expected":35,"kwargs":{},"test_id":"1"},{"args":[[5],[10],4],"comparator":"exact","expected":0,"kwargs":{},"test_id":"2"},{"args":[[],[],10],"comparator":"exact","expected":0,"kwargs":{},"test_id":"3"},{"args":[[2],[3],4],"comparator":"exact","expected":3,"kwargs":{},"test_id":"4"},{"args":[[1,2],[1,1],3],"comparator":"exact","expected":2,"kwargs":{},"test_id":"5"}],"verification":{"baseline_failed_ids":["1","4","5"],"baseline_passed_ids":["2","3"],"evidence_sha256":"7152c7b85fc15ee0d2fd3f047580f3fe98d2f44518e506992ab7533806c59648","image_digest":"python@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535","policy_sha256"